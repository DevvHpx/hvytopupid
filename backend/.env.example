# ============================================================
# HEAVYY TOP UP ID — backend environment
# Copy to .env. NEVER commit real secrets.
# Leave a credential blank to keep that integration disabled
# (the API will respond with an honest "not configured" error).
# ============================================================

NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://heavyy:heavyy@localhost:5432/heavyy?schema=public

# --- Redis (queue + locks) ---
REDIS_URL=redis://localhost:6379

# --- Auth / sessions ---
JWT_SECRET=change-me-min-32-characters-long-secret
JWT_EXPIRES_IN=12h
COOKIE_SECRET=change-me-cookie-secret
ADMIN_COOKIE_NAME=hv_admin
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Payment gateway ---
# provider: midtrans | xendit | custom
PAYMENT_PROVIDER=midtrans
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MERCHANT_ID=

# --- Supplier: Digiflazz ---
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=
DIGIFLAZZ_BASE_URL=https://api.digiflazz.com/v1
DIGIFLAZZ_TESTING=true

# --- Supplier: VIP Reseller ---
VIP_RESELLER_USERNAME=
VIP_RESELLER_API_KEY=
VIP_RESELLER_SECRET=
VIP_RESELLER_BASE_URL=

# --- Supplier: Custom ---
CUSTOM_SUPPLIER_BASE_URL=
CUSTOM_SUPPLIER_API_KEY=

# Default supplier used when a product does not pin one.
SUPPLIER_DEFAULT=digiflazz

# --- Order engine ---
ORDER_MAX_RETRIES=4
ORDER_RETRY_BASE_MS=2000
ORDER_RETRY_MAX_MS=60000
ORDER_LOCK_TTL_MS=30000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_MAX=600

# --- Sandbox (clearly-labelled TEST mode) ---
# Never active in production unless explicitly enabled. When true, a
# "sandbox" payment method can be confirmed via
# POST /api/v1/orders/:orderId/sandbox/confirm to exercise the full
# order flow without moving real money.
SANDBOX_ENABLED=true

# --- Seed admin (used by `npm run seed` only; change immediately) ---
ADMIN_EMAIL=admin@heavyy.local
ADMIN_PASSWORD=ChangeMe123!

