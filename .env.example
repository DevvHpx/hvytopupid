# ============================================================
# HEAVYY TOP UP ID — environment configuration
# Copy to .env and fill in real credentials to go live.
# Leave blank to keep a feature honestly marked "Belum dikonfigurasi".
# ============================================================

# Server
PORT=3000

# Database file (optional; defaults to ./data/hvytopupid.sqlite)
# DB_PATH=./data/hvytopupid.sqlite

# --- Payment gateway ---
# When set, update the `payment_gateway_status` setting to "configured"
# and set each payment method's config_status in the DB.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Top-up supplier / fulfilment ---
SUPPLIER_API_URL=
SUPPLIER_API_KEY=

# --- Account ID validation ---
ID_VALIDATION_API_URL=
ID_VALIDATION_API_KEY=

# --- Admin panel / API ---
ADMIN_TOKEN=
